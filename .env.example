# Необязательные серверные настройки. Ключ OpenAI задаётся администратором в приложении.
MEETING_DATA_DIR=./data
MEETING_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
MEETING_ANALYSIS_MODEL=gpt-4.1-mini

# Cloud mode only. Configure secret values in Vercel, not in this file.
# See DEPLOYMENT.md for provider setup and production/preview isolation.
# MEETING_CLOUD=1
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=meetings
# QSTASH_TOKEN=
# MEETING_WORKER_SECRET=
# MEETING_BOOTSTRAP_TOKEN=
# MEETING_PUBLIC_URL=
# OPENAI_API_KEY=

# MEETING_QUEUE_PROVIDER=vercel

# MEETING_DATABASE_PASSWORD=
